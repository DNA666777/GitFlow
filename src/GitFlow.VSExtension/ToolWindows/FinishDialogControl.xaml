<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
    <DataTemplate.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </DataTemplate.Resources>
    <StackPanel Margin="12" MinWidth="420" MaxWidth="560">
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />

        <StackPanel Visibility="{Binding ShowTagMessage, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
            <TextBlock Text="{Binding TagLabel}" Margin="0,0,0,4"
                       Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
            <TextBox Text="{Binding TagMessage, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
        </StackPanel>

        <CheckBox Content="{Binding PushLabel}" IsChecked="{Binding PushAfterFinish}" IsEnabled="{Binding HasRemote}" Margin="0,0,0,6"
                  Style="{StaticResource {x:Static styles:VsResourceKeys.CheckBoxStyleKey}}" />
        <CheckBox Content="{Binding DeleteRemoteLabel}" IsChecked="{Binding DeleteRemoteBranch}" IsEnabled="{Binding HasRemote}"
                  Style="{StaticResource {x:Static styles:VsResourceKeys.CheckBoxStyleKey}}" />
        <TextBlock Text="{Binding NoRemoteText}" TextWrapping="Wrap" Margin="0,8,0,0" FontStyle="Italic"
                   Visibility="{Binding ShowNoRemote, Converter={StaticResource BoolToVisibility}}"
                   Foreground="{DynamicResource {x:Static styles:VsBrushes.GrayTextKey}}" />
    </StackPanel>
</DataTemplate>
