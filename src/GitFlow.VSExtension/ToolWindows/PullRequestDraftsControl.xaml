<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
    <DockPanel Margin="12" Width="640">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Intro}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
        <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Drafts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                                     Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="320"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                     Style="{StaticResource {x:Static styles:VsResourceKeys.TextBoxStyleKey}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</DataTemplate>
